[Unit]
Description=InteliMarket API (instancia 2 - deploy sin corte)
After=network.target postgresql.service

[Service]
Type=simple
User=intellihouse
WorkingDirectory=/home/intellihouse/intelimarket
EnvironmentFile=/home/intellihouse/intelimarket/.env
Environment=RUN_SCHEDULER=false
ExecStart=/home/intellihouse/intelimarket/.venv/bin/uvicorn api.src.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
