[Unit]
Description=InteliMarket API
After=network.target postgresql.service

[Service]
Type=simple
User=intellihouse
WorkingDirectory=/home/intellihouse/intelimarket
EnvironmentFile=/home/intellihouse/intelimarket/.env
ExecStart=/home/intellihouse/intelimarket/.venv/bin/uvicorn api.src.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
