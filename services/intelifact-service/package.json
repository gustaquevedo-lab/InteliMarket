{
  "name": "intelifact-service",
  "version": "1.0.0",
  "description": "Microservicio InteliFact -- facturacion electronica SIFEN/e-Kuatia, generalizado por tenant. Listo pero inactivo hasta que se decida activarlo para un tenant real.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "intellifact": "file:../intelifact-library"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
