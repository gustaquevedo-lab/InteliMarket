---
import PosMockup from './PosMockup.astro';
---

<section class="relative w-full overflow-hidden pt-32 pb-20 lg:pt-36 lg:pb-28 bg-gradient-to-b from-surface via-surface-container-lowest to-surface transition-colors duration-200">
  <!-- Telemetry Glows Background -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] lg:w-[800px] h-[340px] bg-brand-mint/10 blur-[130px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-12 right-10 w-72 lg:w-96 h-72 lg:h-96 bg-brand-blue/10 blur-[100px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col items-center text-center">
    <!-- Top Pill Announcement -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-surface-container-high border border-outline-variant/40 shadow-sm mb-6">
      <span class="w-2.5 h-2.5 rounded-full bg-brand-mint animate-ping"></span>
      <span class="text-xs font-headline font-bold text-brand-mint uppercase tracking-wider">
        100% Inquebrantable en Producción
      </span>
      <span class="text-outline-variant font-mono text-xs">|</span>
      <span class="text-xs font-mono text-on-surface-variant font-medium">
        SIFEN e-Kuatia Homologado
      </span>
    </div>

    <!-- Main Headline -->
    <h1 class="font-headline text-3xl sm:text-5xl lg:text-6xl font-extrabold text-on-surface max-w-4xl tracking-tight leading-[1.15] mb-6">
      El sistema que <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-mint via-tertiary to-brand-blue">no se cae</span> cuando tu negocio más lo necesita.
    </h1>

    <!-- Subtitle -->
    <p class="text-base sm:text-xl text-on-surface-variant max-w-3xl mb-8 leading-relaxed font-sans font-normal">
      ERP y POS vertical para supermercados, mayoristas y distribuidoras en Paraguay. Vendé sin internet, cobrá en múltiples monedas (PYG, BRL, USD), integrá balanzas y mirá tus ganancias reales al cerrar el día.
    </p>

    <!-- CTAs Cluster -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12 w-full max-w-xl">
      <a
        href="#demo"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-xl bg-brand-mint text-brand-dark font-headline text-base font-bold uppercase tracking-wider hover:brightness-110 active:scale-95 transition-all shadow-glow-secondary"
      >
        <span class="material-symbols-outlined text-[20px]">calendar_today</span>
        <span>Agendá una demo</span>
      </a>

      <a
        href="https://wa.me/595994516360?text=Hola%20InteliMarket,%20quiero%20conocer%20la%20solución%20para%20mi%20comercio"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto inline-flex items-center gap-3 px-6 py-3.5 rounded-xl bg-surface-container-high border border-outline-variant/30 text-on-surface hover:bg-surface-container-highest transition-colors text-left group"
      >
        <div class="w-8 h-8 rounded-full bg-brand-mint/15 flex items-center justify-center text-brand-mint group-hover:scale-110 transition-transform">
          <span class="material-symbols-outlined text-[20px]">chat</span>
        </div>
        <div class="flex flex-col">
          <span class="text-[11px] font-headline font-bold text-brand-mint uppercase tracking-wider leading-none">
            Respuesta Inmediata
          </span>
          <span class="text-xs text-on-surface-variant font-medium mt-0.5">
            Hablemos por WhatsApp
          </span>
        </div>
      </a>
    </div>

    <!-- Trust Badges Strip -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 w-full max-w-4xl p-3 sm:p-4 rounded-2xl bg-surface-container/70 backdrop-blur-xl border border-outline-variant/20 shadow-md mb-12">
      <div class="flex items-center gap-2 justify-center p-2">
        <span class="material-symbols-outlined text-brand-mint text-[20px]">cloud_off</span>
        <span class="text-xs sm:text-sm font-semibold text-on-surface">100% Offline-Ready</span>
      </div>
      <div class="flex items-center gap-2 justify-center p-2">
        <span class="material-symbols-outlined text-tertiary text-[20px]">receipt_long</span>
        <span class="text-xs sm:text-sm font-semibold text-on-surface">SIFEN DNIT Directo</span>
      </div>
      <div class="flex items-center gap-2 justify-center p-2">
        <span class="material-symbols-outlined text-brand-blue text-[20px]">qr_code_scanner</span>
        <span class="text-xs sm:text-sm font-semibold text-on-surface">Bancard • PIX • QR</span>
      </div>
      <div class="flex items-center gap-2 justify-center p-2">
        <span class="material-symbols-outlined text-brand-mint text-[20px]">storefront</span>
        <span class="text-xs sm:text-sm font-semibold text-on-surface">+150 Puntos Activos</span>
      </div>
    </div>

    <!-- Live Split POS & Telemetry Mockup -->
    <div class="w-full max-w-6xl">
      <PosMockup />
    </div>
  </div>
</section>
