---
// PosMockup: Realistic split terminal lane and live telemetry
---

<div class="relative w-full rounded-2xl bg-surface-container-lowest border border-outline-variant/30 p-2 sm:p-4 shadow-2xl text-left overflow-hidden">
  <!-- Window Top Bar -->
  <div class="w-full bg-surface-container-high rounded-xl px-4 py-3 flex flex-wrap items-center justify-between gap-3 mb-3 border border-outline-variant/20">
    <div class="flex items-center gap-3 flex-wrap">
      <div class="flex items-center gap-1.5">
        <span class="w-3 h-3 rounded-full bg-error"></span>
        <span class="w-3 h-3 rounded-full bg-amber-400"></span>
        <span class="w-3 h-3 rounded-full bg-brand-mint"></span>
      </div>
      <div class="h-4 w-px bg-outline-variant/40 hidden sm:block"></div>
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-brand-mint animate-pulse"></span>
        <span class="text-xs sm:text-sm font-headline font-bold text-on-surface">
          InteliMarket POS v4.8 • Caja 03 (Sucursal Central)
        </span>
      </div>
      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-surface-container text-on-surface-variant font-mono text-[11px] border border-outline-variant/20">
        <span class="material-symbols-outlined text-[14px] text-tertiary">sync</span>
        Offline-Ready: Sincronizado
      </span>
    </div>

    <div class="flex items-center gap-3">
      <span class="font-mono text-xs text-on-surface-variant hidden md:inline">
        Cajera: <strong class="text-on-surface">María G.</strong>
      </span>
      <span class="inline-flex items-center gap-1 text-[11px] font-mono text-brand-mint bg-surface-container-lowest px-2.5 py-1 rounded border border-brand-mint/30">
        <span class="material-symbols-outlined text-[14px]">verified</span> SIFEN e-Kuatia: Conectado (0.03s)
      </span>
    </div>
  </div>

  <!-- Main POS Grid: 7 cols register lane, 5 cols telemetry -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-3">
    <!-- LEFT: Register lane -->
    <div class="lg:col-span-7 bg-surface-container rounded-xl p-4 flex flex-col justify-between border border-outline-variant/20">
      <div>
        <!-- Barcode / Scale Active Reticle -->
        <div class="flex items-center gap-3 bg-surface-container-lowest px-3 py-2.5 rounded-lg mb-3 border border-brand-mint/40 shadow-inner">
          <span class="material-symbols-outlined text-brand-mint text-[22px]">barcode_scanner</span>
          <div class="flex-1 font-mono text-xs text-on-surface-variant flex items-center justify-between">
            <span class="text-on-surface font-semibold">EAN-13: 7840003019284 • Balanza Toledo #02</span>
            <span class="px-2 py-0.5 rounded bg-brand-mint/20 text-brand-mint font-bold text-[10px] uppercase">
              Pesado OK
            </span>
          </div>
        </div>

        <!-- Ticket Items -->
        <div class="space-y-2 mb-4">
          <!-- Item 1: Pesable -->
          <div class="flex items-center justify-between p-3 rounded-lg bg-surface-container-high/70 border border-outline-variant/15">
            <div class="flex flex-col">
              <span class="font-headline text-sm font-bold text-on-surface">
                Carne Vacuna T-Bone Especial (Frig. Concepción)
              </span>
              <span class="font-mono text-xs text-on-surface-variant">
                1.450 kg x Gs. 52.000/kg • [Balanza 02 Mostrador]
              </span>
            </div>
            <span class="font-mono text-sm sm:text-base font-bold text-on-surface">
              Gs. 75.400
            </span>
          </div>

          <!-- Item 2 -->
          <div class="flex items-center justify-between p-3 rounded-lg bg-surface-container-high/40 border border-outline-variant/10">
            <div class="flex flex-col">
              <span class="font-headline text-sm font-bold text-on-surface">
                Leche Entera Trébol Sachet 1L (Pack x6)
              </span>
              <span class="font-mono text-xs text-on-surface-variant">
                1 un. x Gs. 34.200 • [Góndola Lácteos]
              </span>
            </div>
            <span class="font-mono text-sm sm:text-base font-bold text-on-surface">
              Gs. 34.200
            </span>
          </div>

          <!-- Item 3 -->
          <div class="flex items-center justify-between p-3 rounded-lg bg-surface-container-high/40 border border-outline-variant/10">
            <div class="flex flex-col">
              <span class="font-headline text-sm font-bold text-on-surface">
                Arroz Tipo 1 Tío Nico 5kg
              </span>
              <span class="font-mono text-xs text-on-surface-variant">
                1 un. x Gs. 28.500 • [Descuento Extra Club aplicado]
              </span>
            </div>
            <span class="font-mono text-sm sm:text-base font-bold text-on-surface">
              Gs. 28.500
            </span>
          </div>
        </div>
      </div>

      <!-- Bottom: Grand Total & Multicurrency conversion -->
      <div class="pt-3 border-t border-outline-variant/30">
        <div class="flex items-end justify-between mb-3 bg-surface-container-lowest p-3.5 rounded-xl border border-outline-variant/30">
          <div>
            <span class="text-xs uppercase font-headline font-bold text-on-surface-variant tracking-wider block">
              Total a Cobrar
            </span>
            <span class="text-xs font-mono text-brand-mint">
              Cobro Bimonetario Activo (PYG / BRL / USD)
            </span>
          </div>
          <div class="text-right">
            <div class="font-headline text-2xl sm:text-3xl font-extrabold text-brand-mint">
              Gs. 138.100
            </div>
            <div class="font-mono text-xs text-on-surface-variant flex items-center justify-end gap-2 mt-0.5">
              <span>R$ 98,64</span>
              <span>•</span>
              <span>US$ 18,41</span>
            </div>
          </div>
        </div>

        <!-- POS Hotkeys -->
        <div class="grid grid-cols-3 gap-1.5 text-center font-mono text-[11px]">
          <div class="p-2 rounded bg-surface-container-high text-on-surface border border-outline-variant/20">
            <strong class="text-brand-mint">[F2]</strong> Balanza
          </div>
          <div class="p-2 rounded bg-surface-container-high text-on-surface border border-outline-variant/20">
            <strong class="text-brand-blue">[F4]</strong> Bimoneda
          </div>
          <div class="p-2 rounded bg-surface-container-high text-on-surface border border-outline-variant/20">
            <strong class="text-tertiary">[F9]</strong> SIFEN e-Kuatia
          </div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Executive Telemetry Feed & Cash Drawer status -->
    <div class="lg:col-span-5 flex flex-col gap-3">
      <!-- Live Sales Metric Card -->
      <div class="bg-surface-container rounded-xl p-4 border border-outline-variant/20 flex-1">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-brand-mint text-[20px]">monitoring</span>
            <span class="font-headline text-xs uppercase font-bold text-on-surface tracking-wider">
              Telemetría Gerencial en Vivo
            </span>
          </div>
          <span class="w-2 h-2 rounded-full bg-brand-mint animate-pulse"></span>
        </div>

        <div class="mb-4">
          <span class="text-xs text-on-surface-variant font-mono">Ventas del Turno (4 cajas activas)</span>
          <div class="font-headline text-2xl font-bold text-on-surface mt-1">
            Gs. 38.450.000
          </div>
          <span class="inline-flex items-center gap-1 text-xs text-brand-mint font-semibold mt-1">
            <span class="material-symbols-outlined text-[16px]">trending_up</span> +14.2% vs mismo horario ayer
          </span>
        </div>

        <!-- Cash Drawer Breakdown (No mixing currencies) -->
        <div class="space-y-2 pt-3 border-t border-outline-variant/20">
          <span class="text-[11px] uppercase font-bold font-mono text-on-surface-variant tracking-wider block">
            Desglose Gaveta Bimonetaria (Sin Mezclas)
          </span>

          <div class="flex items-center justify-between p-2 rounded bg-surface-container-high/60 text-xs">
            <span class="text-on-surface-variant">Efectivo Guaraníes:</span>
            <span class="font-mono font-bold text-on-surface">Gs. 21.200.000</span>
          </div>

          <div class="flex items-center justify-between p-2 rounded bg-surface-container-high/60 text-xs">
            <span class="text-on-surface-variant">Efectivo Reales (Fondo + Recaud.):</span>
            <span class="font-mono font-bold text-brand-mint">R$ 4.250,00</span>
          </div>

          <div class="flex items-center justify-between p-2 rounded bg-surface-container-high/60 text-xs">
            <span class="text-on-surface-variant">Tarjeta / QR / PIX Bancard:</span>
            <span class="font-mono font-bold text-brand-blue">Gs. 11.830.000</span>
          </div>
        </div>
      </div>

      <!-- Realtime Audit & Purchasing Alert -->
      <div class="bg-surface-container-high rounded-xl p-3.5 border border-outline-variant/20">
        <div class="flex items-start gap-2.5">
          <div class="p-1.5 rounded-lg bg-amber-500/10 text-amber-400 mt-0.5">
            <span class="material-symbols-outlined text-[18px]">inventory_2</span>
          </div>
          <div class="flex-1">
            <span class="text-xs font-headline font-bold text-on-surface block">
              Sugerido de Compra Inteligente
            </span>
            <p class="text-[11px] text-on-surface-variant mt-0.5 leading-tight">
              Arroz Tío Nico alcanzó stock mínimo. Orden de compra recomendada enviada al proveedor líder.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
