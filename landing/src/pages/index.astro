---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PainPoints from '../components/PainPoints.astro';
import VerticalSolutions from '../components/VerticalSolutions.astro';
import TechnicalSpecs from '../components/TechnicalSpecs.astro';
import SocialProof from '../components/SocialProof.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<Layout
  title="InteliMarket | El Sistema ERP & POS para Supermercados y Retail en Paraguay"
  description="El sistema que no se cae cuando tu negocio más lo necesita. POS 100% offline-ready, bimonetario nativo (PYG, BRL, USD), SIFEN DNIT homologado, balanzas y arqueos de precisión."
>
  <Header />
  <main class="w-full">
    <Hero />
    <PainPoints />
    <VerticalSolutions />
    <TechnicalSpecs />
    <SocialProof />
    <ContactForm />
  </main>
  <Footer />
  <WhatsAppFloat />
</Layout>
